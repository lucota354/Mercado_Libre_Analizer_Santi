# Mercado Libre
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=
# Optional fallback only for local/manual testing:
MELI_ACCESS_TOKEN=

# Used to encrypt the Mercado Libre OAuth session stored in an HttpOnly cookie.
# Generate a long random value and keep it only in Vercel/local env.
SESSION_ENCRYPTION_KEY=

# Reliable Mercado Libre search fallback (Apify)
APIFY_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
